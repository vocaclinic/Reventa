# Public base URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery. Leave unset until a real integration is configured;
# the form will then tell visitors that online submissions are not yet enabled.
#   webhook - POST the lead as JSON to CONTACT_WEBHOOK_URL (Zapier, Make, CRM, email relay, etc.)
#   console - development only: log submissions to the server console (nothing is delivered)
CONTACT_PROVIDER=
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the "X-Webhook-Secret" header with webhook requests.
CONTACT_WEBHOOK_SECRET=
