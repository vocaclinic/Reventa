# Public base URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery. Leave unset until a real integration is configured;
# the form will then tell visitors that online submissions are not yet enabled.
#   smtp    - email each lead through your own mailbox's SMTP server with Nodemailer (recommended)
#   webhook - POST the lead as JSON to CONTACT_WEBHOOK_URL (Zapier, Make, CRM, etc.)
#   console - development only: log submissions to the server console (nothing is delivered)
CONTACT_PROVIDER=

# --- SMTP (CONTACT_PROVIDER=smtp) -------------------------------------------
# Common settings:
#   Google Workspace: SMTP_HOST=smtp.gmail.com     SMTP_PORT=465
#   Zoho Mail:        SMTP_HOST=smtp.zoho.com      SMTP_PORT=465  (smtp.zoho.eu / .in for those regions)
#   Microsoft 365:    SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Port 465 uses TLS from the start; 587 upgrades with STARTTLS (TLS is always required).
SMTP_HOST=
SMTP_PORT=465
# The mailbox that sends the email, e.g. team@revdian.com
SMTP_USER=
# Use an app password, not the account's normal password.
SMTP_PASS=
# Optional overrides:
#   CONTACT_FROM_EMAIL defaults to "Revdian Website" <SMTP_USER>. Most providers
#   require it to be SMTP_USER or an alias of that mailbox.
#   CONTACT_TO_EMAIL defaults to the contact email in lib/site.ts (team@revdian.com).
#   SMTP_SECURE forces implicit TLS on (true) or off (false); normally leave it unset.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Webhook (CONTACT_PROVIDER=webhook) -------------------------------------
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the "X-Webhook-Secret" header with webhook requests.
CONTACT_WEBHOOK_SECRET=
